# Скопируй этот файл в .env и заполни. Сам .env в git не попадает.

# Supabase: Project Settings → Data API (адрес) и API Keys (ключи)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Только для обработчика на ПК. Даёт полный доступ к базе — никому не показывать.
SUPABASE_SECRET_KEY=sb_secret_...

# Секрет для команды iOS «Поделиться → Жизнь» (придумаем на этапе 3)
ADD_LINK_TOKEN=длинная-случайная-строка
